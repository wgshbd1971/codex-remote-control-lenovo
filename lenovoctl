#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG="$SCRIPT_DIR/.lenovo-device"

usage() {
  cat <<'EOF'
Usage:
  ./lenovoctl configure WINDOWS_USERNAME 192.168.x.x
  ./lenovoctl test
  ./lenovoctl info
  ./lenovoctl diagnose
  ./lenovoctl shell
  ./lenovoctl run COMMAND [ARGUMENTS...]
  ./lenovoctl upload LOCAL_PATH [REMOTE_DIRECTORY]
  ./lenovoctl download REMOTE_PATH [LOCAL_DIRECTORY]
EOF
}

if [[ ${1:-} == configure ]]; then
  [[ $# -eq 3 ]] || { usage; exit 2; }
  printf 'LENOVO_USER=%q\nLENOVO_HOST=%q\n' "$2" "$3" > "$CONFIG"
  chmod 600 "$CONFIG"
  echo "Saved the Lenovo connection as $2@$3"
  exit 0
fi

[[ -f "$CONFIG" ]] || {
  echo "The Lenovo is not configured yet."
  echo "Run: ./lenovoctl configure WINDOWS_USERNAME 192.168.x.x"
  exit 2
}

# shellcheck disable=SC1090
source "$CONFIG"
REMOTE="${LENOVO_USER}@${LENOVO_HOST}"

case ${1:-} in
  test)
    ssh "$REMOTE" 'echo Connected successfully && whoami && hostname'
    ;;
  info)
    ssh "$REMOTE" 'type C:\CodexRemote\connection-info.txt'
    ;;
  diagnose)
    ssh "$REMOTE" 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\CodexRemote\scripts\diagnose-lenovo.ps1'
    ;;
  shell)
    ssh -t "$REMOTE"
    ;;
  run)
    shift
    [[ $# -gt 0 ]] || { usage; exit 2; }
    ssh "$REMOTE" "$@"
    ;;
  upload)
    [[ $# -ge 2 && $# -le 3 ]] || { usage; exit 2; }
    local_path="$2"
    [[ -e "$local_path" ]] || { echo "Local path not found: $local_path"; exit 2; }
    remote_dir="${3:-C:/CodexRemote/inbox/}"
    scp -r "$local_path" "$REMOTE:$remote_dir"
    ;;
  download)
    [[ $# -ge 2 && $# -le 3 ]] || { usage; exit 2; }
    local_dir="${3:-$SCRIPT_DIR/downloads/}"
    mkdir -p "$local_dir"
    scp -r "$REMOTE:$2" "$local_dir"
    ;;
  *)
    usage
    exit 2
    ;;
esac

